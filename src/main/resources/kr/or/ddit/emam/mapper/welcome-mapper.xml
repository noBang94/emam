<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper  namespace="welcome">

    <!-- 지역별 좌표 가져오기 -->
    <select id="getLocalXY" parameterType="String" resultType="WeatherVo">
        select * from location where local_name = #{local_name}
    </select>

</mapper>
