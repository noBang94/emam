<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper  namespace="like">

    <insert id="insertLike" parameterType="kr.or.ddit.emam.vo.ILikeVO">
        insert into ILIKE (POST_INDEX,MEM_ID,ILIKE_DATE) values(#{post_index},#{mem_id},sysdate)
    </insert>

    <delete id="deleteLike" parameterType="kr.or.ddit.emam.vo.ILikeVO">
        delete from ilike where POST_INDEX = #{post_index} and MEM_ID = #{mem_id}
    </delete>

    <select id="LikeCount" parameterType="kr.or.ddit.emam.vo.ILikeVO" resultType="int">
        select count(*) from ILIKE where POST_INDEX = #{post_index}
    </select>

    <select id="Likecheck" parameterType="kr.or.ddit.emam.vo.ILikeVO" resultType="int">
        select count(*) from ILIKE where POST_INDEX = #{post_index} and MEM_ID = #{mem_id}
    </select>

</mapper>
