<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="usersettings">

    <!-- 유저세팅 기본설정 -->
    <!-- 회원가입 시에만 한번 실행되어야 함 -->
    <insert id="insertUsersettings" parameterType="String">
        insert into usersettings
            values(
                #{mem_id},
                1,
                1,
                1,
                1,
                1
            )
    </insert>

    <!-- 유저세팅 확인 -->
    <select id="checkUsersettings" parameterType="String" resultType="usersettingsVo">
        select *
        from usersettings
        where mem_id = #{mem_id}
    </select>

    <!-- 유저세팅(생일 외) 변경 -->
    <update id="updateUsersettings" parameterType="usersettingsVo">
        update usersettings
            set
                set_friend = #{set_friend},
                set_ilike = #{set_ilike},
                set_reply = #{set_reply},
                set_chat = #{set_chat}
        where mem_id = #{mem_id}
    </update>

    <!-- 유저세팅(생일만) 변경 -->
    <update id="updateUsersettingBir" parameterType="usersettingsVo">
        update usersettings
        set
            set_bir = #{set_bir}
        where mem_id = #{mem_id}
    </update>

</mapper>
